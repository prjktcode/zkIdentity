# zkIdentity Configuration
# Copy this file to .env and fill in your values

# Network configuration
# Options: testnet, mainnet
NETWORK=testnet

# Admin address (the address that will have admin privileges)
# This address can register issuers, schemas, and update revocation roots
# Example: aleo1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq3ljyzc
ADMIN_ADDRESS=

# Private key for deployment (DO NOT COMMIT THIS)
# Keep this secure and never share it
# PRIVATE_KEY=

# Aleo network endpoints
TESTNET_API=https://api.explorer.aleo.org/v1
TESTNET_BROADCAST=https://api.explorer.aleo.org/v1/testnet/transaction/broadcast

MAINNET_API=https://api.explorer.aleo.org/v1
MAINNET_BROADCAST=https://api.explorer.aleo.org/v1/mainnet/transaction/broadcast

# Deployment configuration
PRIORITY_FEE=0

# Known issuer IDs (for reference)
# Add your registered issuer IDs here for easy reference
# ISSUER_ID_GOVERNMENT=123456789field
# ISSUER_ID_UNIVERSITY=987654321field
